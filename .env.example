# App
APP_ENV=development
LOG_LEVEL=INFO
LOG_FORMAT=json
SECRET_KEY=change-me-in-production
SERVICE_NAME=migratorgen

# Database
DB_HOST=postgres
DB_PORT=5432
DB_NAME=migrator_platform
DB_USER=migrator_user
DB_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://migrator_user:change-me@postgres:5432/migrator_platform

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me
REDIS_DB=0
REDIS_CACHE_TTL=3600
CELERY_BROKER_URL=redis://:change-me@redis:6379/1
CELERY_RESULT_BACKEND=redis://:change-me@redis:6379/2

# API
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
MAX_FILE_SIZE_MB=10
MAX_FILES_PER_REQUEST=50
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60
ALLOWED_EXTENSIONS=py,txt,pyi

# Storage
UPLOAD_DIR=/data/uploads
OUTPUT_DIR=/data/outputs

# Security
API_KEY_HEADER=X-API-Key
CORS_ORIGINS=http://localhost:3000,https://app.example.com
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=30

# LLM Provider
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-20250514

# Monitoring
METRICS_PORT=9090
ENABLE_TRACING=false
JAEGER_HOST=jaeger
JAEGER_PORT=6831
SENTRY_DSN=

# Email
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASSWORD=
ALERT_EMAIL=alerts@example.com

# Slack
SLACK_WEBHOOK_URL=
SLACK_CHANNEL=#alerts
