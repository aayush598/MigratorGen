FROM python:3.14-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    UV_LINK_MODE=copy

WORKDIR /app

RUN pip install --no-cache-dir uv

COPY pyproject.toml ./
COPY requirements.txt ./
COPY sdk/python/ sdk/python/

RUN uv pip install \
    fastapi \
    "uvicorn[standard]" \
    httpx \
    pydantic \
    pydantic-settings \
    python-multipart \
    aiofiles \
    slowapi \
    --system

COPY . .

RUN uv pip install -e ".[api]" --system && \
    uv pip install -e "sdk/python[all]" --system

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
    CMD curl --fail http://localhost:8000/health || exit 1

CMD ["uvicorn", "backend.api.src.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "4"]