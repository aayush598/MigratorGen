{
  "$defs": {
    "ChangeType": {
      "enum": [
        "rename_function",
        "rename_class",
        "rename_attribute",
        "rename_import",
        "rename_module",
        "rename_parameter",
        "rename_argument",
        "add_argument",
        "remove_argument",
        "change_argument_default",
        "change_type_annotation",
        "reorder_arguments",
        "deprecate_function",
        "deprecate_class",
        "deprecate_module",
        "deprecate_parameter",
        "remove_function",
        "remove_class",
        "replace_with_property",
        "move_to_module",
        "move_to_submodule",
        "move_class_to_module",
        "add_decorator",
        "remove_decorator",
        "change_decorator",
        "sync_to_async",
        "async_to_sync",
        "wrap_in_context_manager",
        "wrap_in_sync_context_manager",
        "class_split",
        "module_split",
        "merge_classes",
        "merge_modules",
        "change_return_type",
        "enum_migration",
        "change_enum_base",
        "dataclass_field_add",
        "dataclass_field_remove",
        "dataclass_field_rename",
        "dataclass_field_change"
      ],
      "title": "ChangeType",
      "type": "string"
    },
    "Rule": {
      "properties": {
        "id": {
          "description": "Unique rule identifier",
          "title": "Id",
          "type": "string"
        },
        "change_type": {
          "$ref": "#/$defs/ChangeType",
          "description": "Kind of migration change"
        },
        "version_introduced": {
          "default": "0.0.0",
          "pattern": "^[\\w.]+$",
          "title": "Version Introduced",
          "type": "string"
        },
        "description": {
          "description": "Human-readable summary",
          "title": "Description",
          "type": "string"
        },
        "old_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Old Name"
        },
        "new_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "New Name"
        },
        "function_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Function Name"
        },
        "argument_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Argument Name"
        },
        "new_argument_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "New Argument Name"
        },
        "default_value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Default Value"
        },
        "new_argument_value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "New Argument Value"
        },
        "new_order": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "New Order"
        },
        "old_module": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Old Module"
        },
        "new_module": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "New Module"
        },
        "source_module": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Module"
        },
        "target_module": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Module"
        },
        "decorator_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Decorator Name"
        },
        "replacement": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Replacement"
        },
        "safety": {
          "default": "safe",
          "pattern": "^(safe|review_required|risky)$",
          "title": "Safety",
          "type": "string"
        },
        "confidence_hint": {
          "default": "high",
          "pattern": "^(high|medium|low)$",
          "title": "Confidence Hint",
          "type": "string"
        },
        "when": {
          "anyOf": [
            {
              "$ref": "#/$defs/RuleWhenCondition"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "priority": {
          "default": 0,
          "minimum": 0,
          "title": "Priority",
          "type": "integer"
        },
        "depends_on": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Depends On"
        },
        "conflicts_with": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Conflicts With"
        },
        "reversible": {
          "default": true,
          "title": "Reversible",
          "type": "boolean"
        },
        "idempotent_safe": {
          "default": true,
          "title": "Idempotent Safe",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "change_type",
        "description"
      ],
      "title": "Rule",
      "type": "object"
    },
    "RuleWhenCondition": {
      "properties": {
        "import_context": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Import Context"
        },
        "imported_from": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Imported From"
        },
        "inside_class": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Inside Class"
        },
        "inside_function": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Inside Function"
        },
        "has_decorator": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Has Decorator"
        },
        "has_annotation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Has Annotation"
        },
        "module_pattern": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Module Pattern"
        }
      },
      "title": "RuleWhenCondition",
      "type": "object"
    },
    "VersionChangelog": {
      "properties": {
        "version": {
          "title": "Version",
          "type": "string"
        },
        "release_date": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Release Date"
        },
        "rules": {
          "items": {
            "$ref": "#/$defs/Rule"
          },
          "title": "Rules",
          "type": "array"
        }
      },
      "required": [
        "version"
      ],
      "title": "VersionChangelog",
      "type": "object"
    }
  },
  "properties": {
    "library": {
      "title": "Library",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "versions": {
      "items": {
        "$ref": "#/$defs/VersionChangelog"
      },
      "title": "Versions",
      "type": "array"
    }
  },
  "required": [
    "library"
  ],
  "title": "MigrationFile",
  "type": "object"
}